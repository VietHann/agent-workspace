{
  "name": "@viethann/agent-workspace",
  "version": "0.1.1",
  "description": "Give your coding agent a team, not another prompt.",
  "type": "module",
  "bin": {
    "agent-workspace": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "prepare": "tsup",
    "prepublishOnly": "node scripts/validate.mjs --build"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "codex",
    "claude-code",
    "cursor",
    "copilot",
    "developer-tools"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VietHann/agent-workspace.git"
  },
  "homepage": "https://github.com/VietHann/agent-workspace#readme",
  "bugs": {
    "url": "https://github.com/VietHann/agent-workspace/issues"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
